{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PaperTrace",
  "version": "0.1.0",
  "identifier": "edu.hku.comp7608.papertrace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "theme": "Light",
        "title": "PaperTrace",
        "decorations": false,
        "width": 1440,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.icns", "icons/icon.png", "icons/icon.ico"]
  }
}
